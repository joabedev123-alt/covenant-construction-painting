# A persistent directory is required on the production server.
# CMS_DATA_DIR=/var/lib/covenant-cms
# Required to create the initial admin account in production; use a random secret.
# ADMIN_SETUP_TOKEN=

# Estimate notifications by SMS. Configure only on the server / .env.local.
# Recipient is fixed in code: +15084056918. These keys are never NEXT_PUBLIC_.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Use a Messaging Service with an SMS-capable sender, OR a Twilio sender number.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
